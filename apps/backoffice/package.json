{
  "name": "backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Back office de VolutrainMed: autoría, revisión y publicación de contenido, personas, analítica y auditoría.",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
