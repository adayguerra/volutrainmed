{
  "name": "volutrainmed",
  "private": true,
  "version": "0.1.0",
  "description": "VolutrainMed: entrenador formativo de cálculo de dosis y volúmenes. Monorepo con app Flutter, API, motor de plantillas y back office.",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "openspec:validate": "npx -y @fission-ai/openspec@latest validate --all --strict"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}
